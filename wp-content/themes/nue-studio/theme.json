{
  "$schema": "https://schemas.wp.org/wp/6.4/theme.json",
  "version": 2,
  "settings": {
    "appearanceTools": true,
    "color": {
      "palette": [
        {
          "slug": "ivory",
          "name": "Ivory",
          "color": "#fdfcfb"
        },
        {
          "slug": "ink",
          "name": "Ink",
          "color": "#1c1917"
        },
        {
          "slug": "chocolate",
          "name": "Chocolate",
          "color": "#9e4a5a"
        },
        {
          "slug": "gold",
          "name": "Gold",
          "color": "#c2697a"
        },
        {
          "slug": "beige",
          "name": "Beige",
          "color": "#f0d4d9"
        },
        {
          "slug": "sand",
          "name": "Sand",
          "color": "#ede8e0"
        }
      ]
    },
    "layout": {
      "contentSize": "1200px",
      "wideSize": "1400px"
    },
    "typography": {
      "fluid": true,
      "fontFamilies": [
        {
          "fontFamily": "\"Estedad\", \"Vazirmatn\", sans-serif",
          "slug": "persian-display",
          "name": "Estedad — فارسی",
          "fontFace": [
            {
              "fontFamily": "Estedad",
              "fontStyle": "normal",
              "fontWeight": "100 900",
              "fontDisplay": "swap",
              "src": [
                "file:./assets/fonts/estedad-arabic-wght-normal.woff2"
              ],
              "unicodeRange": "U+0600-06FF,U+0750-077F,U+0870-089F,U+08A0-08FF,U+200C-200F,U+FB50-FDFF,U+FE70-FEFF"
            },
            {
              "fontFamily": "Estedad",
              "fontStyle": "normal",
              "fontWeight": "100 900",
              "fontDisplay": "swap",
              "src": [
                "file:./assets/fonts/estedad-latin-wght-normal.woff2"
              ],
              "unicodeRange": "U+0000-00FF,U+2000-206F"
            }
          ]
        },
        {
          "fontFamily": "\"Vazirmatn\", sans-serif",
          "slug": "persian",
          "name": "Vazirmatn (فارسی)",
          "fontFace": [
            {
              "fontFamily": "Vazirmatn",
              "fontStyle": "normal",
              "fontWeight": "100 900",
              "fontDisplay": "swap",
              "src": [
                "file:./assets/fonts/vazirmatn-arabic-wght-normal.woff2"
              ],
              "unicodeRange": "U+0600-06FF,U+0750-077F,U+0870-089F,U+08A0-08FF,U+200C-200F,U+FB50-FDFF,U+FE70-FEFF"
            },
            {
              "fontFamily": "Vazirmatn",
              "fontStyle": "normal",
              "fontWeight": "100 900",
              "fontDisplay": "swap",
              "src": [
                "file:./assets/fonts/vazirmatn-latin-wght-normal.woff2"
              ],
              "unicodeRange": "U+0000-00FF,U+2000-206F,U+20AC,U+2191-2193"
            }
          ]
        },
        {
          "fontFamily": "\"Noto Naskh Arabic\", \"Vazirmatn\", serif",
          "slug": "persian-editorial",
          "name": "نسخ — تیتر",
          "fontFace": [
            {
              "fontFamily": "Noto Naskh Arabic",
              "fontStyle": "normal",
              "fontWeight": "400 700",
              "fontDisplay": "swap",
              "src": [
                "file:./assets/fonts/noto-naskh-arabic-arabic-wght-normal.woff2"
              ],
              "unicodeRange": "U+0600-06FF,U+0750-077F,U+0870-089F,U+08A0-08FF,U+200C-200F,U+FB50-FDFF,U+FE70-FEFF"
            }
          ]
        },
        {
          "fontFamily": "\"Cormorant Garamond\", Georgia, serif",
          "slug": "editorial",
          "name": "Editorial Serif",
          "fontFace": [
            {
              "fontFamily": "Cormorant Garamond",
              "fontStyle": "normal",
              "fontWeight": "300 700",
              "src": [
                "file:./assets/fonts/cormorant-garamond-latin-wght-normal.woff2"
              ]
            },
            {
              "fontFamily": "Cormorant Garamond",
              "fontStyle": "italic",
              "fontWeight": "300 700",
              "src": [
                "file:./assets/fonts/cormorant-garamond-latin-wght-italic.woff2"
              ]
            }
          ]
        },
        {
          "fontFamily": "\"DM Sans\", Arial, sans-serif",
          "slug": "sans",
          "name": "Clean Sans",
          "fontFace": [
            {
              "fontFamily": "DM Sans",
              "fontStyle": "normal",
              "fontWeight": "100 1000",
              "src": [
                "file:./assets/fonts/dm-sans-latin-wght-normal.woff2"
              ]
            },
            {
              "fontFamily": "DM Sans",
              "fontStyle": "italic",
              "fontWeight": "100 1000",
              "src": [
                "file:./assets/fonts/dm-sans-latin-wght-italic.woff2"
              ]
            }
          ]
        }
      ],
      "fontSizes": [
        {
          "slug": "small",
          "size": "0.8rem",
          "name": "Small"
        },
        {
          "slug": "normal",
          "size": "1rem",
          "name": "Normal"
        },
        {
          "slug": "large",
          "size": "1.35rem",
          "name": "Large"
        },
        {
          "slug": "display",
          "size": "clamp(3rem, 6vw, 6.5rem)",
          "name": "Display"
        }
      ]
    },
    "spacing": {
      "units": [
        "px",
        "rem",
        "%",
        "vw"
      ]
    }
  },
  "styles": {
    "color": {
      "background": "var:preset|color|ivory",
      "text": "var:preset|color|ink"
    },
    "typography": {
      "fontFamily": "var:preset|font-family|persian",
      "lineHeight": "1.65"
    },
    "elements": {
      "heading": {
        "typography": {
          "fontFamily": "var:preset|font-family|persian-display",
          "fontWeight": "400",
          "lineHeight": "1.45"
        }
      },
      "link": {
        "color": {
          "text": "inherit"
        }
      },
      "button": {
        "border": {
          "radius": "0px"
        },
        "color": {
          "background": "var:preset|color|chocolate",
          "text": "var:preset|color|ivory"
        },
        "typography": {
          "fontSize": "0.75rem",
          "fontWeight": "600",
          "letterSpacing": "0",
          "textTransform": "none"
        },
        "spacing": {
          "padding": {
            "top": "1.05rem",
            "right": "1.8rem",
            "bottom": "1.05rem",
            "left": "1.8rem"
          }
        }
      }
    }
  },
  "templateParts": [
    {
      "name": "header",
      "title": "Header",
      "area": "header"
    },
    {
      "name": "footer",
      "title": "Footer",
      "area": "footer"
    }
  ]
}
