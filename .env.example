# Copy to .env and replace both passwords with different strong values.
# Do not commit .env. Database credentials are used only on initial DB creation.
WORDPRESS_IMAGE=wordpress:php8.3-apache
WORDPRESS_BIND_ADDRESS=127.0.0.1
WORDPRESS_PORT=8080
MARIADB_DATABASE=nue_studio
MARIADB_USER=nue_user
MARIADB_PASSWORD=replace-with-a-strong-database-password
MARIADB_ROOT_PASSWORD=replace-with-a-different-strong-root-password
